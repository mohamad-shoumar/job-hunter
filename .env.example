# Copy to .env. Real environment variables win over this file. Every line is optional: without a key,
# the step that needs it is skipped with a note, and the rest still runs.

# About you. Printed on every CV (build.py), cover letter and email signature, and kept out of git.
# Each one wins over the same line in profile/master_profile.md's Basics. MY_NAME's last word
# starts the file names (Doe_Resume_General.pdf, Doe_CoverLetter_Acme_Oct2026.md).
MY_NAME=
MY_EMAIL=
MY_PHONE=
MY_LINKEDIN=
MY_GITHUB=
MY_PORTFOLIO=
MY_LOCATION=

# The lowest monthly pay, in US dollars, you would move to the UAE or Qatar for ("relocation" in
# config/filters.json). A job there that states less is rejected. Empty: pay is not checked.
RELOCATION_MIN_MONTHLY_USD=

# Enables the Google Jobs source (serpapi.com). Without it that source is skipped.
SERPAPI_API_KEY=

# DeepSeek (platform.deepseek.com): the default model for the AI eligibility check's first step
# (config/ai_check.json), the fit grade (config/fit_grade.json) and tailored CVs (cv_model in
# config/outreach.json), and for the email's proof sentence when pitch_mode is "ai" (pitch_model).
DEEPSEEK_API_KEY=

# Where the Claude Code CLI is, if `claude` is not on PATH or in ~/.local/bin. The defaults use it for
# the AI check's web step and posting-date lookups (web_model in config/ai_check.json) and for cover
# letters (cover_model). It runs on your Claude login, not on ANTHROPIC_API_KEY.
CLAUDE_CODE_BIN=

# The Anthropic API (console.anthropic.com). Not needed with the default settings. Used only for a
# claude-* model in any of the config files, and for the contact lookup's "search the web" backup
# (fallback_model in config/outreach.json).
ANTHROPIC_API_KEY=

# Finds who to email about a job: company size, the right person, their email
# (hunter.io, free plan 50 credits/month). Without it the app can still search the web
# with Claude (ANTHROPIC_API_KEY) or take a contact you type in. Settings: config/outreach.json.
HUNTER_API_KEY=

# Sends the emails from the web app (only when you click Send) and reads Gmail
# for replies and bounces. Needs 2-Step Verification and an app password from
# myaccount.google.com/apppasswords (16 characters; spaces are fine).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

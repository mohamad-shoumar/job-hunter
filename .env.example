# Copy to .env. Real environment variables win over this file.

# About you. Printed on every CV (build.py), cover letter and email signature, and kept out of git.
# Each one wins over the same line in profile/master_profile.md's Basics. MY_NAME's last word
# starts the file names (Doe_Resume_General.pdf, Doe_CoverLetter_Acme_Oct2026.md).
MY_NAME=
MY_EMAIL=
MY_PHONE=
MY_LINKEDIN=
MY_GITHUB=
MY_LOCATION=

# Optional. Enables the Google Jobs source (serpapi.com). Without it that source is skipped.
SERPAPI_API_KEY=

# Optional. Enables the AI web check for jobs the rules leave unclear, the email drafts in the
# web app and its web-search backup for contacts (console.anthropic.com).
# Without it these are skipped with a note. Settings: config/ai_check.json, config/outreach.json.
ANTHROPIC_API_KEY=

# Optional. Finds who to email about a job: company size, the right person, their email
# (hunter.io, free plan 50 credits/month). Without it the app can still search the web
# with Claude (ANTHROPIC_API_KEY) or take a contact you type in. Settings: config/outreach.json.
HUNTER_API_KEY=

# Optional. Sends the emails from the web app (only when you click Send) and reads Gmail
# for replies and bounces. Needs 2-Step Verification and an app password from
# myaccount.google.com/apppasswords (16 characters; spaces are fine).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional. Writes the email drafts when config/outreach.json has "pitch_model": "deepseek-flash"
# (platform.deepseek.com). DeepSeek has no web search, so the AI eligibility check and the
# "search the web" contact backup still need ANTHROPIC_API_KEY.
DEEPSEEK_API_KEY=

# Optional. Where the Claude Code CLI is, for "cover_model": "claude-code" (it uses your Claude
# login, not ANTHROPIC_API_KEY). Only needed when `claude` is not on PATH or in ~/.local/bin.
CLAUDE_CODE_BIN=

# Copy to .env. Real environment variables win over this file.

# Optional. Enables the Google Jobs source (serpapi.com). Without it that source is skipped.
SERPAPI_API_KEY=

# Optional. Enables the AI web check for jobs the rules leave unclear (console.anthropic.com).
# Without it the check is skipped with a note. Settings: config/ai_check.json.
ANTHROPIC_API_KEY=

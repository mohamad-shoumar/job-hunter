{
  "_about": "Deterministic job filters. Title keywords match whole words on a normalized title: lowercase, no accents, 'back-end'/'back end' -> 'backend', 'full-stack' -> 'fullstack', 'front-end' -> 'frontend', 'Sr.' -> 'senior', plurals of engineer/developer folded. After editing, run `jobhunter reclassify` to re-apply to stored jobs.",

  "max_posting_age_days": 30,
  "reject_if_required_yoe_at_least": 6,
  "stretch_yoe_at_least": 5,
  "dedupe_window_days": 60,

  "_blocked_companies": "Companies you never want shortlisted again. Rejected before any other rule, with the reason quoted. Matched on the normalized company name (Inc, Ltd, .com etc. ignored).",
  "blocked_companies": [
    {"name": "Tailscale", "why": "roles need residence in Canada, the US or the UK"},
    {"name": "Reddit", "why": "remote roles are US-only"},
    {"name": "WorkHero", "why": "international engineering roles closed; the rest are US-only"}
  ],

  "_agencies": "Staffing agencies and talent marketplaces: they repost other companies' jobs, sell vetted developers or pay per task. Rejected (code agency) with what matched: a name below, a whole word in the company name, or a phrase in the posting. not_agencies: real companies a name word would catch. Checked against the stored jobs 2026-10-10: 'our clients', 'talent pool' and 'talent network' are left out because real companies (Zscaler, Percona, GitLab) use them.",
  "agencies": {
    "names": [
      "Jobs for Humanity", "EWOR", "Xperteez Technology", "G2i", "micro1", "Turing", "Proxify", "Alignerr",
      "Toptal", "remote quest jobs", "remotepromsp", "TechBiz Global", "Talent Journey", "XKTalent Inc. - Rimutee",
      "Arc.dev", "Crossover", "Andela", "Mercor", "Outlier", "DataAnnotation", "BairesDev", "Lemon.io", "Gun.io",
      "Braintrust", "Revelo", "Terminal.io", "Hired", "Jobgether", "ZeinCrew", "Vermillion Analytics",
      "SupportYourApp", "Qureos", "OpenTrain AI", "Vetto", "A.Team", "Remotebase", "RemoteHub", "Workana",
      "DistantJob", "Akkodis", "Opinov8", "Growe Talents", "EasySoftGroup", "SynergisticIT", "Ampcus",
      "Embedded Shishya", "Oxford Knight", "Allshore Talent", "Careerswift"
    ],
    "name_words": [
      "talent", "talents", "recruiter", "recruiters", "recruiting", "recruitment", "staffing",
      "headhunter", "headhunters", "headhunting", "outsourcing", "hiring solutions", "talent platform"
    ],
    "description_phrases": [
      "on behalf of our client", "on behalf of a client", "on behalf of my client", "a client of ours",

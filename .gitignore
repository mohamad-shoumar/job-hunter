.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.env
# Tokens other tools leave in the project (e.g. resume/.clickup_token).
.clickup_token
*.token

# Runtime state and output: the database is the system's memory, reports are
# generated from it. Neither belongs in git.
data/
reports/

# macOS folder metadata
.DS_Store

# You: your profile and master CV are yours, not code. Git has an example of each
# (*.example.md, a made-up person); copy it and fill it in. Your name and contact
# details go in .env (MY_NAME, MY_EMAIL, ...).
profile/master_profile.md
resume/resume.md

# The resume folder: build.py is tracked; the CVs, cover letters and the
# applications sheet it produces are personal output, like reports/.
resume/versions/
resume/output/
resume/applications.csv

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The one daily run, at 21:00 local time (the 09:00 run was removed 2026-11-19): it sees
  the whole European and US working day. It fetches serpapi too. If the Mac is asleep then,
  launchd runs it on wake.
  It ends with the daily digest (the digest argument below): the day's top jobs and a project idea each,
  in reports/digest_<date>.md. A digest failure never fails the run.
  Then, when the pipeline succeeded, the apply-job skill runs with nobody at the keyboard (the
  --apply-job argument, scripts/apply_job.sh): it fills the To apply forms in Chrome and stops
  before Submit; its report goes to reports/apply_<date>.md, its log to data/apply_job.log.
  Remove that argument to fetch only. AbandonProcessGroup keeps the app it may start running.
  Install (from the project folder; it fills in your paths):
             sed "s|__PROJECT__|$PWD|; s|__HOME__|$HOME|" scripts/local.jobhunter.evening.plist \
               > ~/Library/LaunchAgents/local.jobhunter.evening.plist
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.jobhunter.evening.plist
  Run now:   launchctl kickstart gui/$(id -u)/local.jobhunter.evening
  Remove:    launchctl bootout gui/$(id -u)/local.jobhunter.evening
             rm ~/Library/LaunchAgents/local.jobhunter.evening.plist
  Pipeline output goes to data/run.log; launchd's own errors to ~/Library/Logs/jobhunter.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.jobhunter.evening</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__PROJECT__/scripts/run_daily.sh</string>
        <string>--digest</string>
        <string>--apply-job</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/jobhunter.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/jobhunter.log</string>
</dict>
</plist>

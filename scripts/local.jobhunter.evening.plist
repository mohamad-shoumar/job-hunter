<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Second daily run at 21:00 local time, for the jobs posted since the 09:00 run (most
  are posted 14:00-17:00 Lebanon time, the US morning). It skips serpapi: its credits
  last for one run a day. If the Mac is asleep then, launchd runs it on wake.
  Install (from the project folder; it fills in your paths):
             sed "s|__PROJECT__|$PWD|; s|__HOME__|$HOME|" scripts/local.jobhunter.evening.plist \
               > ~/Library/LaunchAgents/local.jobhunter.evening.plist
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.jobhunter.evening.plist
  Run now:   launchctl kickstart gui/$(id -u)/local.jobhunter.evening
  Remove:    launchctl bootout gui/$(id -u)/local.jobhunter.evening
             rm ~/Library/LaunchAgents/local.jobhunter.evening.plist
  Pipeline output goes to data/run.log; launchd's own errors to ~/Library/Logs/jobhunter.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.jobhunter.evening</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__PROJECT__/scripts/run_daily.sh</string>
        <string>--skip</string>
        <string>serpapi</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/jobhunter.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/jobhunter.log</string>
</dict>
</plist>
